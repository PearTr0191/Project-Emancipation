# Runtime / browser artifacts
/.playwright-mcp
/.playwright-ig-profile
/.playwright_auth_profile
/__pycache__
*.pyc

# Kilo runtime (keep plans/, agents/, commands/ — ignore node_modules)
/.kilo/node_modules/

# Pipeline ephemeral state (regeneratable from posts_index.json)
/pending_codes.json
/pipeline_state.json
/manifest_delta.json
/cookies.json
/cookies.meta.json

# Per-code download directories (pipeline creates <CODE>/<timestamp>.mp4)
/[A-Za-z][A-Za-z0-9_-]{8,16}/
!/mentor/

# Chrome profile junction (created by older pipeline versions; do not commit)
/chrome_profile

# Backup / safety copies
/manifest.json.bak

# Session-debug JSON (one-off extracts from authenticated IG/Playwright scrapes)
/_auth_*.json
/_raw_extract_*.json
/_ocr_results_*.json
/_carousel_ocr_*.json
/_slide_assets_*/
/_audio_probe.json
/_main_reel_video_urls.json
/_target_audio_url.txt

# Ad-hoc transcripts from failed pipeline attempts (superseded by canonical transcripts)
/post*_final*.md
/post*_final*.png